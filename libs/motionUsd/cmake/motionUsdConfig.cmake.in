@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# OpenUSD's pxrConfig.cmake defines imported targets unconditionally, so skip it
# when a consumer has already resolved the UsdSkel target this package needs.
if(NOT TARGET usdSkel AND NOT TARGET pxr::usdSkel)
    find_dependency(pxr CONFIG REQUIRED)
endif()
if(NOT TARGET motionCore::motionCore)
    find_dependency(motionCore CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/motionUsdTargets.cmake")
check_required_components(motionUsd)
