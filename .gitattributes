# Normalize text to LF in the repository; each checkout converts as it likes.
* text=auto

# USDA goldens and fixtures check out with LF everywhere. A CRLF smudge changes
# the *content* of a multi-line (triple-quoted) string -- the \r becomes part of
# the parsed value -- so a Windows checkout would flatten to different bytes
# than the committed golden (usd-vrm-plugins, PR #42).
*.usda text eol=lf

# Capture traces check out with LF everywhere. motionRecording_corpus re-emits
# each committed trace through the writer -- which always writes LF -- and
# compares raw bytes, and motionRecording_traceGen compares them with the
# generator's output, so a CRLF smudge on a Windows checkout would fail both for
# every trace while the data itself was fine.
*.trace text eol=lf

# Recorded motion and packet captures are compared byte for byte.
# A BVH file is text, and it checks out with LF everywhere as it does in
# usd-vrm-plugins, where the corpus came from: the recorded manifest pins each
# file's hash, so a CRLF smudge would make every recorded file a different
# capture.
*.bvh text eol=lf
*.vrma binary
*.npz binary
