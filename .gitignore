# --- OpenStrata / build state (tool-owned, never committed) ---
/build/
**/build/
**/dist/
/.strata/
**/.strata/
CMakeUserPresets.json
strata.lock
# What a generated CI job creates in its checkout: the bootstrapped `ost` and
# its OST_HOME (the materialized runtime).
/.ost-ci/
/.ost-ci-home/

# Nothing the build produces lands in the source tree: bundles and tools are
# staged in the binary tree (cmake/UsdMotionStage.cmake), so a lib/, bin/ or
# plugInfo.json appearing under plugins/ or tools/ is a regression for
# `git status` to show, not to hide.

# --- CMake / MSVC generated ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll

# --- Python cache ---
__pycache__/
*.pyc

# --- Docs scratch ---
/docs/local/

# --- Editor / OS noise ---
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Agent / assistant tooling (local, not shared) ---
/.claude/
